 WIND 12.0 270.0
    
 GEN3 KOMEN DRAG FIT AGROW
    
 OFF BREAKING
    
 NUM STOPC 0.005 0.01 0.005 99.5 STAT 80
    
 POINTS 'tg' 1000.00 0.00 3000.00 0.00 5000.00 0.00
    
 TABLE 'tg' HEAD 'windsea.tbl' XP YP DEP HSIGN TM01 DIR DSPR
    
 SPECOUT 'tg' SPEC2D ABS 'windsea.sp2'
    
